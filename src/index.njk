---
layout: base.njk
---
{%- from "macros.njk" import cartao %}
<section class="topo">
  <img src="/img/awhuuu-emblema.webp" width="1100" height="1100" alt="Awhuuu!: um lobisomem toca guitarra e uiva diante da lua cheia">
  <p class="assinatura">rock · noite · estrada</p>
  <a class="botao" href="#ultimas">Ler as matérias</a>
</section>

<section class="secao manifesto">
  <div class="faixa">
    <p class="rotulo">Manifesto</p>
    <h1>O rock morreu. Esqueceram de avisar o lobo.</h1>
    <p>Já deram o rock como morto mais vezes do que dá para contar. Na era da disco, na do pop, na do streaming. Toda lua cheia ele volta.</p>
    <p>O Awhuuu! é um acervo vivo de rock: discos, shows, lugares, histórias e a cena daqui, cruzados entre si, checados na fonte e contados de madrugada. Sem algoritmo de autoajuda e sem playlist de elevador.</p>
    <p>Aqui os monstros são os anfitriões, e a casa é de quem chega. <a href="/pra-quem/">Pra quem é o Awhuuu! →</a></p>
  </div>
</section>

<section class="secao" id="ultimas">
  <div class="faixa">
    <p class="rotulo">Acabou de sair</p>
    <h2>Últimas do acervo</h2>
    {% if collections.materias.length %}
    <div class="lista">
      {% for m in collections.materias | limite(6) %}{{ cartao(m, editorias) }}{% endfor %}
    </div>
    <p style="margin-top:40px"><a class="botao contorno" href="/materias/">Todas as matérias</a></p>
    {% else %}
    <p class="vazio">A primeira matéria sai na próxima lua cheia. Enquanto isso, o uivo está no <a href="https://www.instagram.com/awhuuu.rock/">Instagram</a>.</p>
    {% endif %}
  </div>
</section>

{%- set lojaHome = [] -%}
{%- for p in loja.proprios.itens -%}{%- if p.ativo and lojaHome.length < 4 -%}{%- set lojaHome = (lojaHome.push(p), lojaHome) -%}{%- endif -%}{%- endfor -%}
{% if loja.proprios.ativo and loja.proprios.na_home !== false and lojaHome.length %}
<section class="secao loja-home" id="loja-home">
  <div class="faixa">
    <p class="rotulo">Loja do lobo</p>
    <h2>Coisas do Awhuuu!</h2>
    <ul class="loja-grade">
      {% for p in lojaHome %}
      <li class="loja-item">
        <img src="{{ p.imagem }}" alt="{{ p.imagem_alt }}" width="300" height="300" loading="lazy">
        <h3>{{ p.nome }}</h3>
        <p class="loja-preco">{{ p.preco }}</p>
        <a class="loja-botao" href="{{ p.link }}" target="_blank" rel="noopener">Comprar</a>
      </li>
      {% endfor %}
    </ul>
    <p style="margin-top:28px"><a class="botao contorno" href="/loja/">Ver a loja inteira</a></p>
  </div>
</section>
{% endif %}


{% if site.trilha and site.trilha.mostrar and site.trilha.spotify_playlist %}
<section class="secao" aria-labelledby="titulo-trilha">
  <div class="faixa">
    <p class="rotulo">Fita Gasta</p>
    <h2 id="titulo-trilha">{{ site.trilha.titulo }}</h2>
    {% if site.trilha.texto %}<p>{{ site.trilha.texto }}</p>{% endif %}
    <div class="embed-spotify"><iframe src="https://open.spotify.com/embed/playlist/{{ site.trilha.spotify_playlist }}?theme=0" title="Playlist no Spotify" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe></div>
  </div>
</section>
{% endif %}

{% if site.youtube and site.youtube.mostrar and (youtube.videos.length or youtube.playlists.length or site.youtube.playlist_reserva) %}
<section class="secao" aria-labelledby="titulo-canal">
  <div class="faixa">
    <p class="rotulo">YouTube</p>
    <h2 id="titulo-canal">{{ site.youtube.titulo }}</h2>
    {% if site.youtube.texto %}<p>{{ site.youtube.texto }}</p>{% endif %}
    {% if youtube.videos.length %}
    <div class="grade-videos">
      {% for vid in youtube.videos | limite(site.youtube.quantos or 4) %}
      <figure>
        {%- set v = { tipo: "youtube", id: vid.id, vertical: vid.short } %}{% set titulo = vid.titulo %}{% include "video.njk" %}
        <figcaption>{{ vid.titulo }}</figcaption>
      </figure>
      {% endfor %}
    </div>
    {% elif not youtube.playlists.length %}
    <div class="embed"><iframe src="https://www.youtube-nocookie.com/embed/videoseries?list={{ site.youtube.playlist_reserva }}" title="Playlist no YouTube" loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
    {% endif %}
    {% if youtube.playlists.length %}
    {% set pls = youtube.playlists | playlistsDaHome(collections.materias) %}
    <h3 class="sub-canal">{{ site.youtube.titulo_playlists or "Playlists" }} <span>({{ pls.length }})</span></h3>
    <div class="grade-playlists">
      {% for p in pls | limite(site.youtube.quantas_playlists or 8) %}
      <a class="playlist" href="{{ p.url_materia or ('https://www.youtube.com/playlist?list=' + p.id) }}"{% if not p.url_materia %} target="_blank" rel="noopener"{% endif %}>
        <span class="capa">{% if p.capa %}<img src="{{ p.capa }}" alt="" loading="lazy" width="480" height="360">{% endif %}<span class="faixas">{{ p.faixas }} faixas</span></span>
        <span class="nome">{{ p.titulo }}</span>
        {% if p.url_materia %}<span class="obs">Leia a matéria e ouça</span>{% elif p.em_breve %}<span class="obs">Matéria chega em {{ p.data_materia | diaMes }}</span>{% else %}<span class="obs">Ouça no YouTube</span>{% endif %}
      </a>
      {% endfor %}
    </div>
    {% endif %}
    <p class="botoes"><a class="botao contorno" href="https://www.youtube.com/@awhuuurock" target="_blank" rel="noopener">Inscreva-se no canal</a> <a class="botao contorno" href="https://www.youtube.com/@awhuuurock/playlists" target="_blank" rel="noopener">Todas as playlists</a></p>
  </div>
</section>
{% endif %}

<section class="secao" id="hoje-no-rock">
  <div class="faixa">
    <p class="rotulo">Neste dia no rock</p>
    <h2 id="hr-titulo">Hoje no rock</h2>
    <ol class="nd-lista curta" id="hr-lista"></ol>
    <p><a class="botao contorno" href="/neste-dia/">Ver o dia inteiro e outros dias</a></p>
  </div>
</section>
<script>
(function(){
  var d=new Date(Date.now()-3*3600e3), k=String(d.getUTCMonth()+1).padStart(2,'0')+'-'+String(d.getUTCDate()).padStart(2,'0');
  var M=['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
  document.getElementById('hr-titulo').textContent='Hoje, '+d.getUTCDate()+' de '+M[d.getUTCMonth()];
  var e_=function(t){return String(t||'').replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});};
  fetch('/dados/neste-dia.json').then(function(r){return r.json();}).then(function(j){
    var it=(j[k]||[]).slice().sort(function(a,b){return (b.tipo==='fato')-(a.tipo==='fato')||(b.br?1:0)-(a.br?1:0);}).slice(0,4);
    if(!it.length){ document.getElementById('hoje-no-rock').hidden=true; return; }
    document.getElementById('hr-lista').innerHTML=it.map(function(e){
      var n=e.ficha?'<a href="'+e.ficha+'">'+e_(e.nome)+'</a>':e_(e.nome);
      var t=e.tipo==='fato'?e_(e.texto)+(e.url?' <a href="'+e.url+'">Leia →</a>':''):e.tipo==='nasce'?'Nasce '+n+'.':e.tipo==='morre'?'Morre '+n+'.':e.tipo==='banda'?'Nasce a banda '+n+'.':'Sai o disco <em>'+e_(e.nome)+'</em>, de '+e_(e.de)+'.';
      return '<li class="nd-'+e.tipo+'"><span class="nd-ano">'+e.ano+'</span><p>'+t+'</p></li>';
    }).join('');
  }).catch(function(){ document.getElementById('hoje-no-rock').hidden=true; });
})();
</script>

<section class="secao" style="padding-top:0;border-top:0">
  <div class="faixa">{% include "newsletter.njk" %}</div>
</section>

<section class="secao" id="editorias">
  <div class="faixa">
    <p class="rotulo">Por onde o lobo anda</p>
    <h2>As editorias</h2>
    <div class="grade-ed">
      {% for e in editorias %}
      <a class="ed-card" href="{{ e.link or ('/editoria/' + e.slug + '/') }}">
        <img src="{{ e.capa }}" alt="" loading="lazy" width="800" height="1000">
        <div class="txt">
          <h3>{{ e.nome }}</h3>
          <p>{{ e.descricao }}</p>
          {% if not e.ativa and not (collections.materias | daEditoria(e.slug)).length %}<span class="breve">em breve</span>{% endif %}
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="secao" aria-labelledby="titulo-lua">
  <div class="faixa">
    <p class="rotulo">Sexta de Lua Cheia</p>
    <h2 id="titulo-lua">A próxima transformação</h2>
    <div class="lua-caixa">
      <div class="disco-lua" aria-hidden="true"></div>
      <div class="lua-texto">
        <p>Próxima edição especial:</p>
        <p class="lua-data" id="sexta-lua">—</p>
        <p id="detalhe-lua">Calculando a lua…</p>
      </div>
    </div>
  </div>
</section>



<section class="secao" id="contato">
  <div class="faixa">
    <p class="rotulo">Onde uivar junto</p>
    <h2>Redes e parcerias</h2>
    <ul class="redes">
      {% for r in site.redes %}<li><a href="{{ r.url }}" target="_blank" rel="noopener">{{ r.nome }} · {{ r.rotulo }}</a></li>{% endfor %}
    </ul>
    <p style="max-width:60ch;color:var(--cinza)">Casa de show, produtora, escola de música, banda ou loja de discos? <a href="/parcerias/">Veja como fazer parte</a>. A cena se faz junto.</p>
  </div>
</section>

<script>
  // Lua cheia aproximada (média do ciclo lunar), suficiente para marcar a edição do mês.
  (function () {
    var SINODICO = 29.530588853, LUA_NOVA_REF = Date.UTC(2000, 0, 6, 18, 14), DIA = 86400000;
    var agora = Date.now();
    var ciclo = Math.floor((agora - LUA_NOVA_REF) / (SINODICO * DIA)) - 1;
    function sextaDoCiclo(n) {
      var cheia = LUA_NOVA_REF + (n + 0.5) * SINODICO * DIA;
      var dif = 5 - new Date(cheia).getDay();
      if (dif > 3) dif -= 7;
      if (dif < -3) dif += 7;
      var sexta = new Date(cheia + dif * DIA);
      sexta.setHours(23, 59, 59, 0);
      return { cheia: new Date(cheia), sexta: sexta };
    }
    var r = sextaDoCiclo(ciclo);
    while (r.sexta.getTime() < agora) { ciclo += 1; r = sextaDoCiclo(ciclo); }
    var fmt = { day: 'numeric', month: 'long' };
    document.getElementById('sexta-lua').textContent = 'Sexta, ' + r.sexta.toLocaleDateString('pt-BR', fmt);
    document.getElementById('detalhe-lua').textContent =
      'A lua cheia deste ciclo cai por volta de ' + r.cheia.toLocaleDateString('pt-BR', fmt) + '. A data é aproximada, como toda boa lenda.';
  })();
</script>
