---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.nome }} — {{ site.lema }}</title>
  <link>{{ site.url }}/</link>
  <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
  <description>{{ site.descricao }}</description>
  <language>pt-BR</language>
  {%- for m in collections.materias | limite(20) %}
  <item>
    <title>{{ m.data.title }}</title>
    <link>{{ m.url | absoluta(site.url) }}</link>
    <guid>{{ m.url | absoluta(site.url) }}</guid>
    <pubDate>{{ m.date.toUTCString() }}</pubDate>
    <description>{{ m.data.resumo }}</description>
  </item>
  {%- endfor %}
</channel>
</rss>
