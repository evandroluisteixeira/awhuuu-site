---
layout: base.njk
permalink: /clube/
eleventyComputed:
  title: "{{ clube.titulo }}"
descricao: Assinatura de discos do Awhuuu!. A história do rock, a discografia de uma banda ou um estilo, um disco por mês. Versão digital com playlist.
---
<section class="secao" style="border-top:0">
  <div class="faixa">
    <p class="rotulo">Clube</p>
    <h1 class="titulo-pag">{{ clube.titulo }}</h1>
    <p class="chamada-pag">{{ clube.chamada }}</p>

    <ol class="passos">
      {% for p in clube.passos %}<li><span>{{ loop.index }}</span>{{ p }}</li>{% endfor %}
    </ol>

    <h2 class="sub-pag">Assinaturas</h2>
    <div class="pacotes">
      {% for a in clube.assinaturas %}{% if a.ativo %}
      <article class="pacote">
        <h2>{{ a.nome }}</h2>
        <p>{{ a.resumo }}</p>
        {% if a.sugestoes.length %}<h3>{{ a.sugestoes_titulo or "Por exemplo" }}</h3><ul class="etiquetas">{% for s in a.sugestoes %}<li>{{ s }}</li>{% endfor %}</ul>{% endif %}
        {% if a.link_pagamento %}<a class="botao" href="{{ a.link_pagamento }}" target="_blank" rel="noopener">Assinar</a>{% else %}<a class="botao contorno" href="#espera">{{ clube.espera.botao }}</a>{% endif %}
      </article>
      {% endif %}{% endfor %}
    </div>

    <div class="versoes">
      {% for v in clube.versoes %}
      <div class="versao">
        <h3>{{ v.nome }}</h3>
        <p class="preco">{{ v.preco or "Preço em breve" }}</p>
        <p>{{ v.texto }}</p>
      </div>
      {% endfor %}
    </div>

    <h2 class="sub-pag">Caixas para presente</h2>
    <div class="pacotes">
      {% for c in clube.caixas %}{% if c.ativo %}
      <article class="pacote">
        <h2>{{ c.nome }}</h2>
        <p class="preco">{{ c.preco or "Preço em breve" }}</p>
        <p>{{ c.resumo }}</p>
        {% if c.inclui.length %}<h3>Vem na caixa</h3><ul>{% for i in c.inclui %}<li>{{ i }}</li>{% endfor %}</ul>{% endif %}
        {% if c.link_pagamento %}<a class="botao" href="{{ c.link_pagamento }}" target="_blank" rel="noopener">Comprar</a>{% else %}<a class="botao contorno" href="#espera">{{ clube.espera.botao }}</a>{% endif %}
      </article>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="secao apoio" id="espera">
  <div class="faixa">
    <h2>{{ clube.espera.titulo }}</h2>
    <p class="chamada-pag">{{ clube.espera.texto }}</p>
    {% if clube.espera.link %}<a class="botao" href="{{ clube.espera.link }}" target="_blank" rel="noopener">{{ clube.espera.botao }}</a>{% endif %}
  </div>
</section>

<section class="secao">
  <div class="faixa">
    <p class="miudo">{{ clube.rodape }} <a href="/parcerias/">Anuncie no Awhuuu!</a></p>
  </div>
</section>
