<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set tituloPag = (title + " · " + site.nome) if title else (site.nome + " — " + site.lema) %}
{%- set descPag = resumo or descricao or site.descricao %}
{%- set imgPag = (capa_social or capa or "/img/og-awhuuu.jpg") | absoluta(site.url) %}
<title>{{ tituloPag }}</title>
<meta name="description" content="{{ descPag }}">
<link rel="canonical" href="{{ page.url | absoluta(site.url) }}">
<meta property="og:title" content="{{ title or tituloPag }}">
<meta property="og:description" content="{{ descPag }}">
<meta property="og:image" content="{{ imgPag }}">
<meta property="og:url" content="{{ page.url | absoluta(site.url) }}">
<meta property="og:type" content="{{ 'article' if editoria else 'website' }}">
<meta property="og:locale" content="pt_BR">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0A0A0A">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" type="image/png" href="/img/favicon-64.png" sizes="64x64">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="{{ site.nome }}" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Saira+Stencil+One&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/estilo.css?v={{ versao }}">
{%- if site.analytics and site.analytics.umami_id %}
<script defer src="https://cloud.umami.is/script.js" data-website-id="{{ site.analytics.umami_id }}" data-domains="awhuuu.com.br"></script>
{%- endif %}
</head>
<body>
<a class="pular" href="#conteudo">Pular para o conteúdo</a>
<svg class="grao" aria-hidden="true" width="100%" height="100%">
  <filter id="grao"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"></feTurbulence></filter>
  <rect width="100%" height="100%" filter="url(#grao)"></rect>
</svg>

<header class="barra">
  <div class="faixa">
    <a class="marca" href="/" aria-label="Awhuuu!, página inicial"><img src="/img/awhuuu-palavra.webp" width="900" height="560" alt="Awhuuu!"></a>
    <nav aria-label="Principal">
      <a href="/materias/"{% if page.url == "/materias/" %} aria-current="page"{% endif %}>Matérias</a>
      <a href="/#editorias">Editorias</a>
      <a href="/agenda/"{% if page.url == "/agenda/" %} aria-current="page"{% endif %}>Agenda</a>
      <a href="/casas/"{% if (page.url or "") is string and "/casas/" in (page.url or "") %} aria-current="page"{% endif %}>Casas</a>
      <a href="/bandas/"{% if (page.url or "") is string and "/bandas/" in (page.url or "") %} aria-current="page"{% endif %}>Bandas</a>
      <a href="/mapa/"{% if page.url == "/mapa/" %} aria-current="page"{% endif %}>Mapa</a>
      <a href="/jogos/"{% if (page.url or "") is string and "/jogos/" in (page.url or "") %} aria-current="page"{% endif %}>Jogos</a>
      <a href="/clube/"{% if page.url == "/clube/" %} aria-current="page"{% endif %}>Clube</a>
    </nav>
  </div>
</header>

<main id="conteudo">
{{ content | safe }}
</main>

<footer>
  <img src="/img/awhuuu-palavra.webp" width="900" height="560" alt="Awhuuu!">
  <p>{{ site.lema }} · feito em Santa Catarina · © <span id="ano">2026</span></p>
  {% if site.afiliados_ativos %}<p class="miudo">Como Associado Amazon, o Awhuuu! ganha com compras qualificadas.</p>{% endif %}
  <p>{% for r in site.redes %}<a href="{{ r.url }}" target="_blank" rel="noopener">{{ r.nome }}</a>{% if not loop.last %} · {% endif %}{% endfor %} · <a href="/feed.xml">RSS</a> · <a href="/pra-quem/">Pra quem é</a> · <a href="/quem-escreve/">Quem escreve</a> · <a href="/privacidade/">Privacidade</a></p>
</footer>
<script>document.getElementById('ano').textContent = new Date().getFullYear();</script>
<script>
(function(){
  // YouTube só carrega quando a pessoa clica (página mais leve)
  document.addEventListener('click',function(e){
    var b=e.target.closest('.yt-lite'); if(!b) return;
    var f=document.createElement('iframe');
    f.src='https://www.youtube-nocookie.com/embed/'+b.dataset.id+'?autoplay=1';
    f.title='Vídeo no YouTube'; f.allow='autoplay; encrypted-media; picture-in-picture'; f.allowFullscreen=true;
    b.replaceWith(f);
  });
  // TikTok e Instagram: o script deles só entra se a página tiver um vídeo deles
  function carrega(src){var s=document.createElement('script');s.async=true;s.src=src;document.body.appendChild(s);}
  if(document.querySelector('.tiktok-embed')) carrega('https://www.tiktok.com/embed.js');
  if(document.querySelector('.instagram-media')) carrega('https://www.instagram.com/embed.js');
  // compartilhar
  document.querySelectorAll('.compartilhar').forEach(function(c){
    var url=c.dataset.url, txt=c.dataset.texto;
    var nat=c.querySelector('.comp-nativo');
    if(navigator.share&&nat){nat.hidden=false;nat.addEventListener('click',function(){navigator.share({title:txt,text:txt,url:url}).catch(function(){});});}
    var cp=c.querySelector('.comp-copiar');
    cp&&cp.addEventListener('click',function(){
      var ok=function(){cp.textContent='Link copiado!';setTimeout(function(){cp.textContent='Copiar link';},2000);};
      if(navigator.clipboard){navigator.clipboard.writeText(url).then(ok,function(){prompt('Copie o link:',url);});} else {prompt('Copie o link:',url);}
    });
  });
})();
</script>
</body>
</html>
