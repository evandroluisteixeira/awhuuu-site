---
layout: base.njk
permalink: /jogos/banda-do-dia/
eleventyComputed:
  title: "{{ jogos.banda_do_dia.titulo }}"
descricao: Adivinhe a banda do dia em seis chances. Cada erro abre uma pista nova. Uma banda nova todo dia.
---
{%- set BD = jogos.banda_do_dia %}
<section class="secao" style="border-top:0">
  <div class="faixa jogo">
    <p class="rotulo"><a href="/jogos/">Jogos</a> · Todo dia</p>
    <h1 class="titulo-pag">{{ BD.titulo }}</h1>
    <p class="chamada-pag">{{ BD.texto }} A banda muda à meia-noite.</p>
    <div class="bd">
      <p class="passo" id="bd-num"></p>
      <ol class="bd-pistas" id="bd-pistas"></ol>
      <form id="bd-form" class="bd-form" autocomplete="off">
        <label class="sr" for="bd-chute">Seu palpite</label>
        <input id="bd-chute" list="bd-nomes" placeholder="Digite o nome da banda ou artista" required>
        <datalist id="bd-nomes">{% for b in bandas | bandasAtivas %}<option value="{{ b.nome }}">{% endfor %}</datalist>
        <button class="botao" type="submit">Chutar</button>
      </form>
      <ul class="bd-chutes" id="bd-chutes" aria-live="polite"></ul>
      <div id="bd-fim" aria-live="polite"></div>
      <p class="miudo" id="bd-placar"></p>
    </div>
  </div>
</section>
<script>
window.BANDAS={{ bandas | bandasAtivas | dump | safe }};
window.BD_INICIO={{ BD.inicio | dump | safe }};
</script>
<script>
(function(){
  var MAX=6, todas=window.BANDAS;
  var sem=function(t){return String(t||'').normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().replace(/^the /,'').replace(/[^a-z0-9]+/g,'');};
  var e_=function(t){return String(t||'').replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});};
  var ok=todas.filter(function(b){return b.inicio && b.estilos && b.estilos.length && b.pais;}).sort(function(a,b){return a.slug<b.slug?-1:1;});
  function rng(s){return function(){s|=0;s=s+0x6D2B79F5|0;var t=Math.imul(s^s>>>15,1|s);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
  var r=rng(666), ordem=ok.slice(); for(var k=ordem.length-1;k>0;k--){var j=Math.floor(r()*(k+1));var x=ordem[k];ordem[k]=ordem[j];ordem[j]=x;}
  var agora=new Date(Date.now()-3*3600e3), hoje=agora.toISOString().slice(0,10);
  var p=window.BD_INICIO.split('-'), dia=Math.max(0,Math.floor((Date.UTC(agora.getUTCFullYear(),agora.getUTCMonth(),agora.getUTCDate())-Date.UTC(+p[0],+p[1]-1,+p[2]))/864e5));
  var alvo=ordem[dia%ordem.length], num=dia+1, ano=String(alvo.inicio).slice(0,4);
  var pessoa=alvo.tipo==='artista';
  var pistas=[
    'Estilo: '+alvo.estilos.slice(0,3).join(', '),
    (pessoa?'Artista solo':'Banda')+' de '+alvo.pais,
    (pessoa?'Nasceu':'Começou')+' nos anos '+ano.slice(2,3)+'0'+(ano<'1900'?'':''),
    alvo.cidade?'Cidade: '+alvo.cidade:'O nome tem '+alvo.nome.replace(/\s/g,'').length+' letras',
    (pessoa?'Nascimento':'Formação')+': '+ano,
    'Começa com '+alvo.nome.replace(/^(The|Os|As) /,'').charAt(0).toUpperCase()+(/^(The|Os|As) /.test(alvo.nome)?' (sem contar o artigo)':'')
  ];
  if(+ano<1950||+ano>=2000) pistas[2]=(pessoa?'Nasceu':'Começou')+' na década de '+ano.slice(0,3)+'0';
  var chave='awhuuu-bd-'+hoje, est; try{ est=JSON.parse(localStorage.getItem(chave))||{chutes:[],fim:false}; }catch(e){ est={chutes:[],fim:false}; }
  function salva(){ try{ localStorage.setItem(chave,JSON.stringify(est)); }catch(e){} }
  function placar(venceu){
    var s; try{ s=JSON.parse(localStorage.getItem('awhuuu-bd-placar'))||{jogos:0,vitorias:0,seq:0,ult:''}; }catch(e){ s={jogos:0,vitorias:0,seq:0,ult:''}; }
    if(venceu!==undefined && s.ult!==hoje){ s.jogos++; if(venceu){ s.vitorias++; s.seq=(s.ultVit===ontem()?s.seq:0)+1; s.ultVit=hoje; } else s.seq=0; s.ult=hoje; try{ localStorage.setItem('awhuuu-bd-placar',JSON.stringify(s)); }catch(e){} }
    document.getElementById('bd-placar').textContent=s.jogos?('Você jogou '+s.jogos+' vez'+(s.jogos>1?'es':'')+', acertou '+s.vitorias+'. Sequência: '+s.seq+'.'):'';
  }
  function ontem(){ return new Date(Date.now()-3*3600e3-864e5).toISOString().slice(0,10); }
  function desenha(){
    document.getElementById('bd-num').textContent='Banda do Dia nº '+num+' · '+(MAX-est.chutes.length)+' chance'+(MAX-est.chutes.length===1?'':'s');
    var abertas=Math.min(est.chutes.length+1,MAX);
    if(est.fim) abertas=MAX;
    document.getElementById('bd-pistas').innerHTML=pistas.map(function(t,k){return '<li'+(k<abertas?'':' class="fechada"')+'>'+(k<abertas?e_(t):'Pista '+(k+1))+'</li>';}).join('');
    document.getElementById('bd-chutes').innerHTML=est.chutes.map(function(c){return '<li class="'+(sem(c)===sem(alvo.nome)?'certo':'errado')+'">'+e_(c)+'</li>';}).join('');
    if(est.fim){
      document.getElementById('bd-form').hidden=true;
      var venceu=est.chutes.some(function(c){return sem(c)===sem(alvo.nome);});
      document.getElementById('bd-fim').innerHTML='<div class="resultado so-texto"><p class="rotulo">'+(venceu?'Acertou em '+est.chutes.length+'.':'Não foi hoje.')+'</p><h2 class="grande">'+e_(alvo.nome)+'</h2><p class="botoes"><a class="botao contorno" href="/bandas/'+alvo.slug+'/">Ver a página da banda</a> <button type="button" class="botao" id="bd-comp">Compartilhar</button></p><p class="miudo">Amanhã tem outra.</p></div>';
      document.getElementById('bd-comp').onclick=function(){
        var grade=est.chutes.map(function(c){return sem(c)===sem(alvo.nome)?'🟩':'🟥';}).join('')+(venceu?'':'⬛');
        var t='🐺 Banda do Dia nº '+num+': '+(venceu?est.chutes.length:'X')+'/'+MAX+'\n'+grade+'\n'+location.href;
        if(navigator.share) navigator.share({text:t}).catch(function(){}); else if(navigator.clipboard) navigator.clipboard.writeText(t).then(function(){ document.getElementById('bd-comp').textContent='Copiado'; });
      };
      placar(venceu);
    } else placar();
  }
  document.getElementById('bd-form').onsubmit=function(ev){
    ev.preventDefault(); var inp=document.getElementById('bd-chute'), v=inp.value.trim(); if(!v) return;
    if(est.chutes.some(function(c){return sem(c)===sem(v);})){ inp.value=''; return; }
    est.chutes.push(v); inp.value='';
    if(sem(v)===sem(alvo.nome)||est.chutes.length>=MAX) est.fim=true;
    salva(); desenha();
  };
  desenha();
})();
</script>
