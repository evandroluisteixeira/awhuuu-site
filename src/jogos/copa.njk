---
layout: base.njk
title: Copa do Rock
permalink: /jogos/copa-do-rock/
descricao: Mata-mata de discos de rock com votação dos leitores do Awhuuu!. Uma rodada por semana.
---
{%- set C = jogos.copa %}
{%- set f = clube.formulario %}
{%- set jcTitulo = C.titulo %}{% set jcTexto = C.texto %}{% set jcImagem = jogos.imagens.copa %}{% set jcQuando = "" %}
{% include "jogo-cab.njk" %}
<section class="secao jogo-palco">
  <div class="faixa jogo">
    <p class="jogo-quando" id="cp-status"></p>
    <div id="cp-atual" class="copa-atual"></div>
    <h2 class="sub-pag">A chave</h2>
    <div id="cp-chave" class="copa-chave"></div>
    <p class="miudo">Um voto por confronto em cada aparelho. Empate dá a vaga para o disco de cima da chave.</p>
  </div>
</section>
<script>
window.COPA={{ C | dump | safe }};
window.COPA_DB={{ {url: f.supabase_url, chave: f.chave_publica} | dump | safe }};
window.FICHAS={{ bandas | bandasAtivas | dump | safe }}.reduce(function(o,b){o[b.nome.toLowerCase()]=b.slug;return o;},{});
</script>
<script>
(function(){
  var C=window.COPA, DB=window.COPA_DB, porId={};
  C.discos.forEach(function(d){porId[d.id]=d;});
  var e_=function(t){return String(t||'').replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});};
  var hoje=new Date(Date.now()-3*3600e3).toISOString().slice(0,10);
  var vis; try{ vis=localStorage.getItem('awhuuu-visitante'); if(!vis){ vis=(crypto.randomUUID?crypto.randomUUID():String(Math.random()).slice(2)+Date.now()); localStorage.setItem('awhuuu-visitante',vis);} }catch(e){ vis='anon-'+Date.now(); }
  var meus; try{ meus=JSON.parse(localStorage.getItem('awhuuu-copa-'+C.slug))||{}; }catch(e){ meus={}; }
  var H={'apikey':DB.chave,'Content-Type':'application/json'}; if(!/^sb_/.test(DB.chave)) H.Authorization='Bearer '+DB.chave;
  var placar={};
  function rodadaAtual(){ for(var r=0;r<C.rodadas.length;r++){ if(hoje>=C.rodadas[r].inicio && hoje<=C.rodadas[r].fim) return r; } return hoje<C.rodadas[0].inicio?-1:C.rodadas.length; }
  function votos(cid,id){ return (placar[cid]&&placar[cid][id])||0; }
  // monta a chave: rodada 0 vem da lista de discos; as outras, dos vencedores
  function chave(){
    var R=[], atual=rodadaAtual();
    var r0=[]; for(var k=0;k<C.discos.length;k+=2) r0.push({id:'r0-'+(k/2),a:C.discos[k].id,b:C.discos[k+1].id});
    R.push(r0);
    for(var r=1;r<C.rodadas.length;r++){
      var ant=R[r-1], cur=[];
      for(var k2=0;k2<ant.length;k2+=2){
        cur.push({id:'r'+r+'-'+(k2/2),a:vencedor(ant[k2],r-1,atual),b:vencedor(ant[k2+1],r-1,atual)});
      }
      R.push(cur);
    }
    return R;
  }
  function vencedor(c,r,atual){
    if(!c||!c.a||!c.b||r>=atual) return null;
    return votos(c.id,c.b)>votos(c.id,c.a)?c.b:c.a;
  }
  function nomeDisco(id){ var d=porId[id]; if(!d) return '<span class="a-definir">a definir</span>'; var s=window.FICHAS[d.banda.toLowerCase()]; return '<strong>'+e_(d.disco)+'</strong><span>'+(s?'<a href="/bandas/'+s+'/">'+e_(d.banda)+'</a>':e_(d.banda))+' · '+d.ano+'</span>'; }
  function desenha(){
    var R=chave(), atual=rodadaAtual(), st=document.getElementById('cp-status'), box=document.getElementById('cp-atual');
    if(atual<0){ st.textContent='A votação começa em '+C.rodadas[0].inicio.split('-').reverse().join('/')+'. Já dá pra ver a chave.'; box.innerHTML=''; }
    else if(atual>=C.rodadas.length){
      var fin=R[R.length-1][0], campeao=vencedor(fin,R.length-1,C.rodadas.length);
      st.textContent='A Copa acabou.'; box.innerHTML=campeao?'<div class="resultado so-texto"><p class="rotulo">Campeão</p><h2 class="grande">'+e_(porId[campeao].disco)+'</h2><p>'+e_(porId[campeao].banda)+', '+porId[campeao].ano+'</p></div>':'';
    } else {
      var ro=C.rodadas[atual]; st.textContent=ro.nome+': vota até '+ro.fim.split('-').reverse().join('/')+'.';
      box.innerHTML=R[atual].map(function(c){
        var votou=meus[c.id], tot=votos(c.id,c.a)+votos(c.id,c.b);
        function lado(id){ var v=votos(c.id,id), pct=tot?Math.round(v*100/tot):0;
          return '<button type="button" class="lado'+(votou===id?' meu':'')+'" data-c="'+c.id+'" data-d="'+id+'"'+(votou?' disabled':'')+'>'+nomeDisco(id)+(votou?'<em class="pct" style="--p:'+pct+'%">'+pct+'%</em>':'')+'</button>'; }
        return '<div class="duelo">'+lado(c.a)+'<span class="x">×</span>'+lado(c.b)+'</div>';
      }).join('');
      box.querySelectorAll('button.lado').forEach(function(b){ b.onclick=function(){ vota(b.dataset.c,b.dataset.d); }; });
    }
    document.getElementById('cp-chave').innerHTML=R.map(function(rod,r){
      return '<div class="coluna"><h3>'+e_(C.rodadas[r].nome)+'</h3>'+rod.map(function(c){
        var v=vencedor(c,r,atual);
        return '<div class="jogo-chave">'+[c.a,c.b].map(function(id){ return '<p class="'+(v&&v===id?'venceu':(v?'perdeu':''))+'">'+(porId[id]?e_(porId[id].disco):'a definir')+(r<atual&&porId[id]?' <small>'+votos(c.id,id)+'</small>':'')+'</p>'; }).join('')+'</div>';
      }).join('')+'</div>';
    }).join('');
  }
  function vota(cid,id){
    meus[cid]=id; try{ localStorage.setItem('awhuuu-copa-'+C.slug,JSON.stringify(meus)); }catch(e){}
    fetch(DB.url.replace(/\/$/,'')+'/rest/v1/votos_copa',{method:'POST',headers:Object.assign({'Prefer':'return=minimal'},H),body:JSON.stringify({copa:C.slug,confronto:cid,escolha:id,visitante:vis})})
      .then(function(){ return carrega(); });
    placar[cid]=placar[cid]||{}; placar[cid][id]=(placar[cid][id]||0)+1; desenha();
  }
  function carrega(){
    if(!DB.url) return Promise.resolve(desenha());
    return fetch(DB.url.replace(/\/$/,'')+'/rest/v1/rpc/placar_copa',{method:'POST',headers:H,body:JSON.stringify({p_copa:C.slug})})
      .then(function(r){return r.json();}).then(function(l){ placar={}; (l||[]).forEach(function(x){ (placar[x.confronto]=placar[x.confronto]||{})[x.escolha]=+x.votos; }); desenha(); })
      .catch(function(){ desenha(); });
  }
  carrega();
})();
</script>
