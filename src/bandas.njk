---
layout: base.njk
title: Bandas e artistas
permalink: /bandas/
descricao: Bandas e artistas do rock, das lendas à cena independente brasileira. Links oficiais, próximos shows, lançamentos e as matérias do Awhuuu! sobre cada uma.
---
{%- set lista = bandas | bandasAtivas %}
{%- set hoje = "" | hojeISO %}
<section class="secao" style="border-top:0">
  <div class="faixa">
    <p class="rotulo">A matilha</p>
    <h1 class="titulo-pag">Bandas e artistas</h1>
    <p class="chamada-pag">{{ bandas.chamada }}</p>
    <p class="botoes"><a class="botao contorno" href="/neste-dia/">Neste dia no rock →</a></p>

    <div class="filtros-bandas">
      <label>Buscar<input type="search" id="busca-banda" placeholder="Nome, cidade, estilo..." autocomplete="off"></label>
      <label>Cena<select id="cena-banda"><option value="">Todas</option><option value="cena local">Cena local</option><option value="clássica">Clássicas</option></select></label>
      <label>País<select id="pais-banda"><option value="">Todos</option>{% set paises = [] %}{% for b in lista %}{% if b.pais and not (b.pais in paises) %}{% set paises = (paises.push(b.pais), paises) %}{% endif %}{% endfor %}{% for p in paises | sort %}<option>{{ p }}</option>{% endfor %}</select></label>
    </div>
    <p class="contagem" id="contagem-bandas" aria-live="polite">{{ lista.length }} bandas e artistas</p>

    <ul class="grade-bandas" id="grade-bandas">
      {% for b in lista %}
      {%- set nShows = (agenda.shows | futuros | showsDaBanda(b)).length %}
      {%- set img = b.foto or b.foto_url %}
      <li data-busca="{{ [b.nome, b.cidade, b.pais, b.estilos | join(' '), b.cena] | join(' ') | lower }}" data-cena="{{ b.cena }}" data-pais="{{ b.pais }}">
        <a class="patch patch-{{ b.estilos | familiaEstilo }}{% if b.cena == 'cena local' %} patch-local{% endif %}{% if img %} com-foto{% elif b.logo %} com-logo{% endif %}" href="/bandas/{{ b.slug }}/">
          {% if img %}<img class="patch-foto" src="{{ img }}" alt="" loading="lazy" referrerpolicy="no-referrer">{% endif %}
          {% if b.cena == 'cena local' %}<span class="patch-tag">cena local</span>{% endif %}
          {% if b.logo and not img %}<span class="patch-logo fundo-{{ b.logo_fundo or 'escuro' }}"><img src="{{ b.logo }}" alt="" loading="lazy"></span>{% endif %}
          <strong{% if b.logo and not img %} class="nome-pequeno"{% endif %}>{{ b.nome }}</strong>
          <span class="origem">{{ [b.cidade, b.pais, (b.inicio | string | truncate(4, true, ""))] | select | join(", ") }}</span>
          {% if nShows %}<span class="tem-show">{{ nShows }} show{% if nShows > 1 %}s{% endif %} na agenda</span>{% endif %}
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

{%- set saiu = [] %}{%- set vem = [] %}
{%- for l in lancamentos.itens %}{% if l.data <= hoje %}{% set saiu = (saiu.push(l), saiu) %}{% else %}{% set vem = (vem.push(l), vem) %}{% endif %}{% endfor %}
{% if saiu.length or vem.length %}
<section class="secao" id="lancamentos">
  <div class="faixa">
    <p class="rotulo">Lançamentos</p>
    <h2>Saiu agora, vem aí</h2>
    <p class="chamada-pag">Discos e EPs das bandas desta página, puxados do MusicBrainz, uma base pública de discografias. Atualiza todo dia.</p>
    <div class="lancamentos">
      {% if vem.length %}<div><h3>Vem aí</h3><ol>{% for l in vem %}<li><time datetime="{{ l.data }}">{{ l.data | dataParcial }}</time> <a href="/bandas/{{ l.slug }}/">{{ l.banda }}</a>: <em>{{ l.titulo }}</em> <small>({{ l.tipo }})</small></li>{% endfor %}</ol></div>{% endif %}
      {% if saiu.length %}<div><h3>Saiu agora</h3><ol>{% for l in saiu | reverse %}<li><time datetime="{{ l.data }}">{{ l.data | dataParcial }}</time> <a href="/bandas/{{ l.slug }}/">{{ l.banda }}</a>: <em>{{ l.titulo }}</em> <small>({{ l.tipo }})</small></li>{% endfor %}</ol></div>{% endif %}
    </div>
  </div>
</section>
{% endif %}

{% if novidades.recentes.length %}
<section class="secao" id="videos-bandas">
  <div class="faixa">
    <p class="rotulo">Direto dos canais oficiais</p>
    <h2>Últimos vídeos</h2>
    <div class="grade-videos">
      {% for v in novidades.recentes %}
      <figure class="video-banda">
        <div class="embed video"><button type="button" class="yt-lite" data-id="{{ v.id }}" aria-label="Tocar o vídeo: {{ v.titulo }}" style="background-image:url(https://i.ytimg.com/vi/{{ v.id }}/hqdefault.jpg)"><span aria-hidden="true">▶</span></button></div>
        <figcaption><a href="/bandas/{{ v.slug }}/">{{ v.banda }}</a> · {{ v.titulo }}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<script>
(function(){
  var busca=document.getElementById('busca-banda'), cena=document.getElementById('cena-banda'), pais=document.getElementById('pais-banda');
  var itens=[].slice.call(document.querySelectorAll('#grade-bandas > li')), cont=document.getElementById('contagem-bandas');
  var sem=function(t){return (t||'').normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase();};
  function filtra(){
    var q=sem(busca.value.trim()), n=0;
    itens.forEach(function(li){
      var ok=(!q||sem(li.dataset.busca).indexOf(q)>-1)&&(!cena.value||li.dataset.cena===cena.value)&&(!pais.value||li.dataset.pais===pais.value);
      li.hidden=!ok; if(ok)n++;
    });
    cont.textContent=n+(n===1?' banda ou artista':' bandas e artistas');
  }
  [busca,cena,pais].forEach(function(el){el.addEventListener('input',filtra);});
})();
</script>
